---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, summary, role, impact, highlights, period, year, tags, color } = project.data;
const when = period ?? year;
---

<a class="card reveal" href={`/projects/${project.id}`} style={`--tile:${color}`}>
  <div class="head">
    <h3>{title}</h3>
    {when && <span class="mono">{when}</span>}
  </div>
  <p class="role">{role}</p>
  <p class="summary">{summary}</p>
  {impact && <p class="impact"><span class="mono">Impact</span>{impact}</p>}
  {
    highlights.length > 0 && (
      <div class="highlights">
        <p class="mono">Projects</p>
        <ul>
          {highlights.map((h) => (
            <li>
              <span class="h-title">{h.title}</span>
              {h.detail && <span class="h-detail">{h.detail}</span>}
            </li>
          ))}
        </ul>
      </div>
    )
  }
  <div class="foot">
    <ul class="tags">{tags.map((t) => <li class="mono">{t}</li>)}</ul>
    <span class="arrow" aria-hidden="true">→</span>
  </div>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 20px 20px 18px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--paper-2) 55%, var(--paper));
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.35s var(--ease);
  }
  /* Colored accent edge, from the project's color. */
  .card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: color-mix(in srgb, var(--tile), #000 22%);
    filter: saturate(2.2);
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--ink-3);
    box-shadow: 0 16px 32px -24px rgba(0, 0, 0, 0.45);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  h3 {
    font-size: 23px;
    line-height: 1.15;
  }
  .head .mono {
    flex-shrink: 0;
  }
  p {
    margin: 0;
  }
  .role {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-3);
  }
  .summary {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .impact {
    display: flex;
    gap: 8px;
    align-items: baseline;
    font-size: 14px;
    line-height: 1.45;
    padding: 8px 10px;
    border-radius: 8px;
    background: var(--paper);
    border: 1px solid var(--line);
  }
  .impact .mono {
    flex-shrink: 0;
    font-size: 10px;
    color: var(--accent);
  }
  .highlights {
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--paper);
    border: 1px solid var(--line);
  }
  .highlights .mono {
    font-size: 10px;
    color: var(--accent);
    margin-bottom: 4px;
  }
  .highlights ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .highlights li {
    display: flex;
    flex-direction: column;
    padding-block: 6px;
  }
  .highlights li + li {
    border-top: 1px dashed var(--line);
  }
  .h-title {
    font-size: 14.5px;
    font-weight: 500;
  }
  .h-detail {
    font-size: 13.5px;
    color: var(--ink-2);
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding-top: 4px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tags li {
    border: 1px solid var(--line);
    padding: 1px 7px;
    border-radius: 4px;
    font-size: 10px;
  }
  .arrow {
    color: var(--ink-3);
    transition: transform 0.3s var(--ease), color 0.3s;
  }
  .card:hover .arrow {
    transform: translateX(4px);
    color: var(--accent);
  }
</style>
