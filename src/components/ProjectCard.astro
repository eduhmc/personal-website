---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}
const { project, index } = Astro.props;
const { title, summary, role, impact, year, tags, color } = project.data;
// Alternate a slight tilt so the grid feels hand-placed.
const tilt = [-1.2, 0.8, -0.4, 1.1][index % 4];
---

<a class="card reveal" href={`/projects/${project.id}`} style={`--tile:${color};--tilt:${tilt}deg`}>
  <div class="tile">
    <span class="tape" aria-hidden="true"></span>
    <span class="tile-title">{title}</span>
  </div>
  <div class="meta">
    <h3>{title}</h3>
    <span class="mono">{year}</span>
  </div>
  <p class="role mono">{role}</p>
  <p>{summary}</p>
  <p class="impact"><span class="mono">Impact</span> {impact}</p>
  <ul class="tags">{tags.map((t) => <li class="mono">{t}</li>)}</ul>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
  }
  .tile {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    background: var(--tile);
    transform: rotate(var(--tilt));
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
    box-shadow: 0 14px 30px -22px rgba(0, 0, 0, 0.4);
  }
  :global([data-theme='dark']) .tile {
    filter: brightness(0.55) saturate(0.9);
  }
  .card:hover .tile {
    transform: rotate(0deg) translateY(-4px);
    box-shadow: 0 22px 40px -24px rgba(0, 0, 0, 0.5);
  }
  .tile-title {
    font-family: var(--font-serif);
    font-size: clamp(24px, 3vw, 34px);
    color: #141414;
    padding: 0 16px;
    text-align: center;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-top: 18px;
  }
  h3 {
    font-size: 24px;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    transition: text-decoration-color 0.2s;
  }
  .card:hover h3 {
    text-decoration-color: var(--accent);
  }
  p {
    margin: 6px 0 10px;
    color: var(--ink-2);
    font-size: 15px;
  }
  .role {
    margin: 4px 0 0;
    font-size: 11px;
    text-transform: none;
  }
  .impact {
    color: var(--ink);
    font-size: 14px;
    padding-left: 10px;
    border-left: 2px solid var(--accent);
  }
  .impact .mono {
    margin-right: 6px;
    font-size: 10.5px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tags li {
    border: 1px solid var(--line);
    padding: 1px 7px;
    border-radius: 4px;
    font-size: 10.5px;
  }
</style>
