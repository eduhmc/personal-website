---
import { Image } from 'astro:assets';
import { categoryColor, type Reference } from '../lib/references';

interface Props {
  reference: Reference;
}
const { reference } = Astro.props;
const { title, category, meaning, feelings, image, imageAlt, source } = reference.data;
---

<a class="ref reveal" href={`/references/${reference.id}`} data-category={category}>
  <div class="media" style={`--tile:${categoryColor[category]}`}>
    {
      image ? (
        <Image src={image} alt={imageAlt ?? ''} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 50vw" />
      ) : (
        <span class="tile-text">{source.name}</span>
      )
    }
  </div>
  <div class="body">
    <p class="mono">{category} · {feelings[0]}</p>
    <h3>{title}</h3>
    <p class="meaning">{meaning}</p>
    <p class="feelings">{feelings.join(' · ')}</p>
  </div>
</a>

<style>
  .ref {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .ref:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 36px -26px rgba(0, 0, 0, 0.45);
  }
  .media {
    aspect-ratio: 4 / 3;
    background: var(--tile);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  :global([data-theme='dark']) .media {
    filter: brightness(0.6);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile-text {
    font-family: var(--font-serif);
    font-size: clamp(22px, 2.6vw, 30px);
    color: #141414;
    text-align: center;
    padding: 0 20px;
  }
  .body {
    padding: 16px 18px 18px;
  }
  .body .mono {
    margin: 0;
    font-size: 11px;
  }
  h3 {
    font-size: 26px;
    margin-top: 6px;
  }
  .meaning {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .feelings {
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--ink-3);
  }
</style>
