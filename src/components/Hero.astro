---
import DotGrid from './DotGrid';
import FactsCard from './FactsCard.astro';
import { site } from '../data/site';
import { likes } from '../data/likes';

// Turn *word* into <em>word</em> for the italic accent in the hero sentence.
const intro = site.intro.replace(/\*(.+?)\*/g, '<em>$1</em>');
---

<section class="hero container">
  <div class="hero-text">
    <p class="mono">Hello — hola</p>
    <h1 set:html={intro} />
    <FactsCard facts={site.facts} />
  </div>
  <div class="hero-art reveal">
    <DotGrid client:visible likes={likes} />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
    padding-block: 56px 72px;
  }
  .hero-text > * + * {
    margin-top: 20px;
  }
  h1 {
    font-size: clamp(40px, 6vw, 68px);
    line-height: 1.04;
    text-wrap: balance;
  }
  h1 :global(em) {
    color: var(--accent);
    font-size: 1em;
  }
  .hero-art {
    transition-delay: 0.15s;
  }

  /* Styles for the React island */
  .hero-art :global(.polaroid) {
    position: relative;
    margin: 0;
    padding: 14px 14px 18px;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 6px;
    box-shadow: 0 1px 0 var(--line), 0 18px 40px -24px rgba(0, 0, 0, 0.35);
    transform: rotate(1.2deg);
    transition: transform 0.6s var(--ease);
  }
  .hero-art :global(.polaroid:hover) {
    transform: rotate(0deg);
  }
  .hero-art :global(.dotgrid-canvas) {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    background: var(--paper);
    border-radius: 3px;
    cursor: pointer;
    touch-action: pan-y;
  }
  .hero-art :global(figcaption) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 12px;
    min-height: 58px;
  }
  .hero-art :global(.caption) {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.25;
    animation: fade-in 0.6s var(--ease);
  }
  .hero-art :global(.chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
    justify-content: center;
  }
  .hero-art :global(.chip) {
    font: inherit;
    font-size: 13px;
    padding: 4px 11px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition: all 0.25s var(--ease);
  }
  .hero-art :global(.chip:hover) {
    border-color: var(--ink-3);
    color: var(--ink);
  }
  .hero-art :global(.chip[aria-pressed='true']) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      filter: blur(4px);
    }
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 24px;
    }
    .hero-art {
      max-width: 420px;
      width: 100%;
      margin-inline: auto;
    }
  }
</style>
