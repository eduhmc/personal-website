---
import { site } from '../data/site';

// Non-breaking hyphens so "product-related" never splits across lines.
const intro = site.intro.replaceAll('-', '‑');
---

<section class="hero container">
  <h1>{intro}</h1>
</section>

<style>
  .hero {
    padding-block: 96px 64px;
  }
  h1 {
    max-width: 900px;
    font-size: clamp(44px, 7vw, 84px);
    line-height: 1.02;
    text-wrap: balance;
  }
  @media (max-width: 560px) {
    .hero {
      padding-block: 48px 32px;
    }
  }
</style>
