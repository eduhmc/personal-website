---
interface Props {
  id: string;
  num: string;
  title: string;
  wide?: boolean;
}
const { id, num, title, wide = false } = Astro.props;
---

<section id={id} class="section container">
  <header class="reveal">
    <span class="mono">{num}</span>
    <h2>{title}</h2>
  </header>
  <div class:list={['body', { measure: !wide }]}>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: 56px;
    scroll-margin-top: 24px;
  }
  header {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 28px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    background-image: linear-gradient(var(--line), var(--line));
    background-size: 100% 1px;
    background-position: 0 calc(100% - 4px);
    background-repeat: no-repeat;
  }
  h2 {
    font-size: clamp(30px, 4vw, 40px);
  }
</style>
