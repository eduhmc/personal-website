---
import Base from '../../layouts/Base.astro';
import ReferenceCard from '../../components/ReferenceCard.astro';
import { getPublicReferences, groupBy, sourceLine } from '../../lib/references';

const refs = await getPublicReferences();
const categories = [...new Set(refs.map((r) => r.data.category))];
const byMeaning = groupBy(refs, (r) => r.data.feelings);
const bySource = groupBy(refs, (r) => [r.data.source.creator ?? r.data.source.name]);
---

<Base title="References" description="Moments, sounds, gestures and ideas that stayed with me, and why.">
  <div class="container refs-page">
    <header class="measure">
      <h1>Things that stay with me.</h1>
      <p class="lede">Moments I keep coming back to.</p>
    </header>

    <div class="tabs" role="tablist" aria-label="View">
      <button role="tab" aria-selected="true" data-view="cards">All</button>
      <button role="tab" aria-selected="false" data-view="meaning">By meaning</button>
      <button role="tab" aria-selected="false" data-view="source">By source</button>
    </div>

    <section data-panel="cards">
      <div class="filters" role="group" aria-label="Filter by category">
        <button class="chip" aria-pressed="true" data-filter="all">All</button>
        {categories.map((c) => <button class="chip" aria-pressed="false" data-filter={c}>{c}</button>)}
      </div>
      <div class="grid">
        {refs.map((r) => <ReferenceCard reference={r} />)}
      </div>
    </section>

    <section data-panel="meaning" hidden>
      {
        byMeaning.map(([feeling, items]) => (
          <div class="group">
            <div class="group-head">
              <h2>{feeling}</h2>
              <span class="mono">
                {items.length} {items.length === 1 ? 'reference' : 'references'}
              </span>
            </div>
            <ul>
              {items.map((r) => (
                <li>
                  <a href={`/references/${r.id}`}>{r.data.title}</a>
                  <span>{r.data.meaning}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section data-panel="source" hidden>
      {
        bySource.map(([source, items]) => (
          <div class="group">
            <div class="group-head">
              <h2>{source}</h2>
              <span class="mono">
                {items.length} {items.length === 1 ? 'reference' : 'references'}
              </span>
            </div>
            <ul>
              {items.map((r) => (
                <li>
                  <a href={`/references/${r.id}`}>{r.data.title}</a>
                  <span>{sourceLine(r)}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </div>
</Base>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-view]');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== tab.dataset.view));
      // Reveal anything in the newly shown panel.
      document.querySelectorAll('[data-panel]:not([hidden]) .reveal').forEach((el) => el.classList.add('is-in'));
    }),
  );

  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('.grid [data-category]');
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      const f = chip.dataset.filter;
      cards.forEach((card) => {
        card.hidden = f !== 'all' && card.dataset.category !== f;
        card.classList.add('is-in');
      });
    }),
  );
</script>

<style>
  .refs-page {
    padding-top: 40px;
  }
  h1 {
    font-size: clamp(44px, 7vw, 72px);
  }
  .lede {
    font-size: 19px;
    color: var(--ink-2);
    margin: 10px 0 0;
  }
  .tabs {
    display: inline-flex;
    gap: 4px;
    margin: 36px 0 20px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .tabs button {
    font: inherit;
    font-size: 14px;
    padding: 6px 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }
  .tabs button[aria-selected='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 24px;
  }
  .chip {
    font: inherit;
    font-size: 13px;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }
  .chip[aria-pressed='true'] {
    border-color: var(--ink);
    color: var(--ink);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
  .grid > [hidden] {
    display: none;
  }
  .group {
    max-width: var(--measure);
    padding-block: 18px;
    border-top: 1px solid var(--line);
  }
  .group-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .group h2 {
    font-size: 28px;
  }
  .group ul {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
  }
  .group li {
    display: flex;
    flex-direction: column;
    padding: 8px 0 8px 16px;
  }
  .group li a {
    text-decoration: none;
    font-weight: 500;
  }
  .group li a:hover {
    text-decoration: underline;
  }
  .group li span {
    color: var(--ink-2);
    font-size: 15px;
  }
</style>
