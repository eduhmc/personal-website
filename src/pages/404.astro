---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <div class="container measure nf">
    <p class="mono">404</p>
    <h1>This page wandered <em>off</em>.</h1>
    <p><a href="/">Back home →</a></p>
  </div>
</Base>

<style>
  .nf {
    padding-block: 96px;
  }
  h1 {
    font-size: clamp(44px, 7vw, 64px);
  }
  h1 em {
    color: var(--accent);
    font-size: 1em;
  }
</style>
