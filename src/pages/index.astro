---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Timeline from '../components/Timeline.astro';
import { site } from '../data/site';

const projects = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <Hero />

  <Section id="about" num="01" title="About">
    {site.about.map((p) => <p class="reveal">{p}</p>)}
  </Section>

  <Section id="work" num="02" title="Things I've shipped" wide>
    <div class="grid">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </Section>

  <Section id="principles" num="03" title="How I think about product">
    <ol class="principles">
      {
        site.principles.map((pr, i) => (
          <li class="reveal">
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{pr.title}</h3>
              <p>{pr.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="experience" num="04" title="Experience">
    <Timeline />
    <p class="reveal more"><a href="/cv">Full CV →</a></p>
  </Section>

  <Section id="now" num="05" title="Now">
    <ul class="now">
      {site.now.map((n) => <li class="reveal">{n}</li>)}
    </ul>
    <p class="reveal mono lab-hint">
      Bored? There's a little game in the <a href="/lab">lab</a>.
    </p>
  </Section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 48px 36px;
  }
  .principles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 22px;
  }
  .principles li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 8px;
  }
  .principles .mono {
    padding-top: 8px;
    color: var(--accent);
  }
  .principles h3 {
    font-size: 26px;
  }
  .principles p {
    margin: 4px 0 0;
    color: var(--ink-2);
  }
  .more {
    margin-top: 20px;
  }
  .now {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .now li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 8px;
  }
  .now li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .lab-hint {
    margin-top: 32px;
    text-transform: none;
  }
</style>
