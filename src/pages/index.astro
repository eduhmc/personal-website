---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Timeline from '../components/Timeline.astro';
import { site, workGroups } from '../data/site';

const projects = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
const groups = workGroups
  .map((g) => ({ ...g, items: projects.filter((p) => p.data.group === g.id) }))
  .filter((g) => g.items.length > 0);
---

<Base>
  <Hero />

  <Section id="about" num="01" title="about">
    {site.about.map((p) => <p class="reveal">{p}</p>)}
  </Section>

  <Section id="experience" num="02" title="experience" wide>
    {
      groups.map((g) => (
        <div class="group">
          <div class="group-head reveal">
            <h3>{g.name}</h3>
            <span class="mono">{g.years}</span>
          </div>
          <div class="grid">
            {g.items.map((p) => (
              <ProjectCard project={p} />
            ))}
          </div>
        </div>
      ))
    }
  </Section>

  <Section id="timeline" num="03" title="timeline">
    <Timeline />
    <p class="reveal more"><a href="/cv">Full CV →</a></p>
  </Section>

</Base>

<style>
  /* Each org: name + dates on the left, its cards on the right. */
  .group {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 16px 32px;
    padding-block: 28px;
    border-top: 1px solid var(--line);
  }
  .group:first-child {
    border-top: 0;
    padding-top: 4px;
  }
  .group-head {
    position: sticky;
    top: 24px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .group-head h3 {
    font-size: 26px;
    line-height: 1.15;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }
  /* A group with one card uses the full row instead of leaving a hole. */
  .grid > :global(:only-child) {
    grid-column: 1 / -1;
  }
  @media (max-width: 760px) {
    .group {
      grid-template-columns: 1fr;
    }
    .group-head {
      position: static;
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .more {
    margin-top: 20px;
  }
</style>
