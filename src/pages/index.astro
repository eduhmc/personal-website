---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Timeline from '../components/Timeline.astro';
import { site, workGroups } from '../data/site';

const projects = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
const groups = workGroups
  .map((g) => ({ ...g, items: projects.filter((p) => p.data.group === g.id) }))
  .filter((g) => g.items.length > 0);
---

<Base>
  <Hero />

  <Section id="about" num="01" title="about">
    {site.about.map((p) => <p class="reveal">{p}</p>)}
  </Section>

  <Section id="experience" num="02" title="experience" wide>
    {
      groups.map((g) => (
        <div class="group">
          <div class="group-head reveal">
            <h3>{g.name}</h3>
            <span class="mono">{g.years}</span>
          </div>
          <div class="grid">
            {g.items.map((p, i) => (
              <ProjectCard project={p} index={i} />
            ))}
          </div>
        </div>
      ))
    }
  </Section>

  <Section id="timeline" num="03" title="timeline">
    <Timeline />
    <p class="reveal more"><a href="/cv">Full CV →</a></p>
  </Section>

</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 48px 36px;
  }
  .group + .group {
    margin-top: 64px;
  }
  .group-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 24px;
  }
  .group-head h3 {
    font-size: 28px;
  }
  .more {
    margin-top: 20px;
  }
</style>
