---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Timeline from '../components/Timeline.astro';
import ReferenceCard from '../components/ReferenceCard.astro';
import { site } from '../data/site';
import { getPublicReferences } from '../lib/references';

const projects = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
const references = (await getPublicReferences()).filter((r) => r.data.featured).slice(0, 4);
---

<Base>
  <Hero />

  <Section id="about" num="01" title="about">
    {site.about.map((p) => <p class="reveal">{p}</p>)}
  </Section>

  <Section id="projects" num="02" title="projects" wide>
    <div class="grid">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </Section>

  <Section id="experience" num="03" title="experience">
    <Timeline />
    <p class="reveal more"><a href="/cv">Full CV →</a></p>
  </Section>

  <Section id="references" num="04" title="things that stay with me" wide>
    <div class="ref-grid">
      {references.map((r) => <ReferenceCard reference={r} />)}
    </div>
    <p class="reveal more"><a href="/references">All references →</a></p>
  </Section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 48px 36px;
  }
  .ref-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 20px;
  }
  .more {
    margin-top: 20px;
  }
</style>
